{
  "mcpServers": {
    "reader": {
      "type": "stdio",
      "command": "${CLAUDE_LOCAL_PYTHON}",
      "args": ["${CLAUDE_LOCAL_TOOLS}/read_page.py"]
    },
    "searxng": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-searxng@2.10.1"],
      "env": {
        "SEARXNG_URL": "${SEARXNG_URL:-http://192.168.1.41:8888}",
        "SEARXNG_MAX_RESULTS": "8",
        "SEARXNG_MAX_RESULT_CHARS": "500"
      }
    }
  }
}
