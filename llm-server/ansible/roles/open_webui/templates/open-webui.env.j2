# Managed by Ansible (open_webui). Contains secrets, mode 0600.

# Settings below are configuration as code: with persistent config off, these
# values win on every start and changes made to them in the admin UI are not kept.
ENABLE_PERSISTENT_CONFIG=false

# --- Reverse proxy (TLS terminates on {{ llm_proxy_ip }}) ---
WEBUI_URL=https://{{ llm_chat_domain }}
# Semicolon-separated. Websockets (streamed replies) are rejected from any other origin.
CORS_ALLOW_ORIGIN=https://{{ llm_chat_domain }}{% for origin in openwebui_extra_origins %};{{ origin }}{% endfor %}

FORWARDED_ALLOW_IPS={{ llm_proxy_ip }}
ENABLE_WEBSOCKET_SUPPORT=true
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true
WEBUI_SESSION_COOKIE_SAME_SITE=lax

# --- Auth ---
WEBUI_SECRET_KEY={{ vault_webui_secret_key }}
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
{% if openwebui_trusted_email_header %}
# Trusted-header SSO. Only safe if nothing but the proxy can reach port 3000:
# narrow llm_allowed_sources to the proxy before enabling it.
WEBUI_AUTH_TRUSTED_EMAIL_HEADER={{ openwebui_trusted_email_header }}
{% if openwebui_trusted_name_header %}
WEBUI_AUTH_TRUSTED_NAME_HEADER={{ openwebui_trusted_name_header }}
{% endif %}
{% endif %}

# --- Model backend: internal Docker network, never the LAN port ---
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URLS=http://{{ llm_backend_alias }}:8000/v1
OPENAI_API_KEYS={{ vault_llm_api_key }}
DEFAULT_MODELS={{ llm_served_model_name }}
# Background tasks use the same model; no second model is ever loaded.
TASK_MODEL_EXTERNAL={{ llm_served_model_name }}
ENABLE_TITLE_GENERATION={{ openwebui_title_generation | lower }}
ENABLE_TAGS_GENERATION={{ openwebui_tags_generation | lower }}
ENABLE_FOLLOW_UP_GENERATION={{ openwebui_follow_up_generation | lower }}
ENABLE_AUTOCOMPLETE_GENERATION={{ openwebui_autocomplete_generation | lower }}

# --- RAG: embeddings on CPU inside this container, no VRAM used ---
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_MODEL={{ openwebui_rag_embedding_model }}
USE_CUDA_DOCKER=false

{% if openwebui_searxng_enabled %}
# --- Web search ---
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
{% else %}
ENABLE_WEB_SEARCH=false
{% endif %}

{% if openwebui_postgres_enabled %}
# --- Database ---
DATABASE_URL=postgresql://openwebui:{{ vault_postgres_password }}@postgres:5432/openwebui
{% endif %}
