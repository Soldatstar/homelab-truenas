#!/bin/sh
# Managed by Ansible (llm_firewall).
#
# Docker publishes ports with DNAT, so that traffic is FORWARDed and never
# reaches ufw's INPUT rules. Docker evaluates the DOCKER-USER chain first and
# never flushes it, so source restrictions belong here.
#
# Policy: a NEW connection that arrives on the LAN interface and is forwarded
# to a container must come from an allowed source. Replies to connections the
# containers opened themselves (image pulls, web search) pass as ESTABLISHED.
set -eu

CHAIN=LLM-INGRESS
IFACE="{{ llm_lan_interface }}"
ALLOWED="{{ (llm_allowed_sources + llm_extra_allowed_sources + (llm_metrics_sources if llm_metrics_enabled else [])) | unique | join(' ') }}"

apply() {
    iptables -w -N DOCKER-USER 2>/dev/null || true
    iptables -w -N "$CHAIN" 2>/dev/null || true
    iptables -w -F "$CHAIN"
    iptables -w -A "$CHAIN" -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
    for src in $ALLOWED; do
        iptables -w -A "$CHAIN" -s "$src" -j RETURN
    done
    iptables -w -A "$CHAIN" -j DROP
    iptables -w -C DOCKER-USER -i "$IFACE" -j "$CHAIN" 2>/dev/null \
        || iptables -w -I DOCKER-USER 1 -i "$IFACE" -j "$CHAIN"
}

remove() {
    iptables -w -D DOCKER-USER -i "$IFACE" -j "$CHAIN" 2>/dev/null || true
    iptables -w -F "$CHAIN" 2>/dev/null || true
    iptables -w -X "$CHAIN" 2>/dev/null || true
}

case "${1:-apply}" in
    apply) apply ;;
    remove) remove ;;
    *) echo "usage: $0 apply|remove" >&2; exit 2 ;;
esac
