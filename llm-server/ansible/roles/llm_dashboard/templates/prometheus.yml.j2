# Managed by Ansible (llm_dashboard).
global:
  scrape_interval: 5s
  evaluation_interval: 15s

scrape_configs:
  # The active inference engine, reached by its network alias. The radiance engine answers
  # /metrics with 401 unless the API key is sent; vLLM ignores the header, so it is always set.
  - job_name: llm-engine
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/engine-api-key
    static_configs:
      - targets: ["{{ llm_backend_alias }}:8000"]

  # GPU temperature, fan, power and VRAM (from llm-gpu-stats) plus host metrics.
  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]
