# Managed by Ansible (open_webui). Internal only: reachable from the Docker
# network by Open WebUI, never published on the host.
use_default_settings: true
server:
  secret_key: "{{ vault_searxng_secret }}"
  limiter: false
  image_proxy: false
  bind_address: "0.0.0.0"
  port: 8080
search:
  safe_search: 0
  formats:
    - html
    - json
