# Managed by Ansible (radiance_engine). Do not edit on the host.
# Model: {{ radiance_model }} ({{ radiance_model_settings.file }}), profile: {{ radiance_profile }}
# ({{ radiance_profile_settings.max_model_len }} tokens x {{ radiance_profile_settings.max_num_seqs }} sequences).
# Flags follow the model cards (huggingface.co/StillDeadcode) and the Level1Techs dual-R9700
# guide. Differences:
#   - bridge network with a LAN-bound published port instead of host networking,
#     so the DOCKER-USER firewall and the internal backend alias keep working;
#     hence --host 0.0.0.0 on the container port 8000
#   - the API key comes from the environment (--api-key-env), never the command line
{% set render_gid = ansible_facts.getent_group['render'][1] | default('') %}
{% set video_gid = ansible_facts.getent_group['video'][1] | default('') %}
name: radiance
services:
  radiance:
    image: "{{ radiance_model_settings.image }}"
    container_name: radiance
    restart: unless-stopped
    init: true
{% if radiance_model_settings.config == 'yaml' %}
    command:
      - --config
      - /etc/radiance/radiance.yaml
{% else %}
    command:
      - --model
      - /models/{{ radiance_model_settings.file }}
      - --host
      - 0.0.0.0
      - --port
      - "8000"
      - --api-key-env
      - RADIANCE_API_KEY
      - --tp
      - "2"
      - --tp-wire
      - "{{ radiance_engine_tp_wire }}"
      - --max-num-seqs
      - "{{ radiance_profile_settings.max_num_seqs }}"
      - --max-model-len
      - "{{ radiance_profile_settings.max_model_len }}"
      - --kv-cache-dtype
      - "{{ radiance_model_settings.kv_cache_dtype }}"
      - --placement
      - "{{ radiance_engine_placement }}"
      - --host-pool-mib
      - "{{ radiance_profile_settings.host_pool_mib | default(radiance_engine_host_pool_mib) }}"
      - --gpu-headroom-mib
      - "{{ radiance_engine_gpu_headroom_mib }}"
{% if radiance_model_settings.expert_vs_cache_ratio | string | length > 0 %}
      - --expert-vs-cache-ratio
      - "{{ radiance_model_settings.expert_vs_cache_ratio }}"
{% endif %}
{% if radiance_model_settings.ngram_placement | length > 0 %}
      - --ngram-placement
      - "{{ radiance_model_settings.ngram_placement }}"
{% endif %}
      - --num-speculative-tokens
      - "{{ radiance_engine_spec_tokens }}"
      - --max-num-batched-tokens
      - "{{ radiance_engine_max_batched_tokens }}"
{% if radiance_engine_prefix_cache_mib | int > 0 %}
      - --prefix-cache-mib
      - "{{ radiance_engine_prefix_cache_mib }}"
{% endif %}
{% if radiance_profile_settings.rope_scaling | length > 0 %}
      - --rope-scaling
      - "{{ radiance_profile_settings.rope_scaling }}"
{% endif %}
{% for arg in radiance_engine_extra_args %}
      - "{{ arg }}"
{% endfor %}
{% endif %}
    env_file:
      - radiance.env
    environment:
      HIP_VISIBLE_DEVICES: "{{ vllm_hip_visible_devices }}"
    devices:
      - /dev/kfd:/dev/kfd
      - /dev/dri:/dev/dri
{% if render_gid or video_gid %}
    group_add:
{% if render_gid %}
      - "{{ render_gid }}"
{% endif %}
{% if video_gid %}
      - "{{ video_gid }}"
{% endif %}
{% endif %}
    cap_add:
      - SYS_PTRACE
    security_opt:
      - seccomp=unconfined
    # Host IPC and a large /dev/shm for the tensor-parallel ranks (the guide uses 32g).
    ipc: host
    shm_size: 32g
    ulimits:
      # memlock: the pinned pools fail with "cannot make a ring" otherwise.
      # nofile: radiance fails with "Too many open files" when the soft limit is 1024.
      memlock: -1
      nofile:
        soft: 524288
        hard: 524288
    ports:
      - "{{ llm_lan_ip }}:{{ llm_api_port }}:8000"
    volumes:
      - "{{ llm_models_dir }}/rad:/models:ro"
{% if radiance_model_settings.config == 'yaml' %}
      - "{{ llm_base_dir }}/radiance/radiance.yaml:/etc/radiance/radiance.yaml:ro"
{% endif %}
    networks:
      llm:
        aliases:
          - "{{ llm_backend_alias }}"
    stop_grace_period: 60s
    healthcheck:
      test: ["CMD", "busybox", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8000/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30m

networks:
  llm:
    external: true
    name: "{{ llm_docker_network }}"
