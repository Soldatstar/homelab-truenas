# Managed by Ansible (open_webui). Used by Open WebUI over the Docker network. With
# openwebui_searxng_publish it is also on the LAN, restricted by the DOCKER-USER firewall;
# it has no login and no rate limit.
use_default_settings: true
server:
  secret_key: "{{ vault_searxng_secret }}"
  limiter: false
  image_proxy: false
  bind_address: "0.0.0.0"
  port: 8080
search:
  safe_search: 0
  formats:
    - html
    - json
{% if (openwebui_searxng_engines_on + openwebui_searxng_engines_off) | length > 0 %}
engines:
{% for name in openwebui_searxng_engines_on %}
  - name: {{ name }}
    disabled: false
{% endfor %}
{% for name in openwebui_searxng_engines_off %}
  - name: {{ name }}
    disabled: true
{% endfor %}
{% endif %}
