        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(vllm:num_preemptions_total[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
