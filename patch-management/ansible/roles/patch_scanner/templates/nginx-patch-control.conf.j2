# Managed by Ansible (patch_scanner): TLS, LAN-only, password-protected front for the control page
limit_req_zone $binary_remote_addr zone=patchctl:1m rate=30r/m;

server {
    listen {{ patch_scanner_control_tls_port }} ssl;
    server_name _;
    ssl_certificate /etc/ssl/certs/patch-control.crt;
    ssl_certificate_key /etc/ssl/private/patch-control.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow {{ patch_scanner_web_allow }};
    deny all;
    auth_basic "Patch control";
    auth_basic_user_file /etc/nginx/patch-control.htpasswd;
    client_max_body_size 64k;
    limit_req zone=patchctl burst=30 nodelay;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }
}
